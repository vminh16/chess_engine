          <mxGeometry x="540" y="720" width="190" height="72" as="geometry" />
        </mxCell>
        <mxCell id="64" value="Shared transform&#xa;S = Mish(BN(Conv1x1(T)))&#xa;channels: C -&gt; mip&#xa;mip = max(8, C / 8) in current repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#4d4d4d;fontSize=12;" vertex="1" parent="1">
