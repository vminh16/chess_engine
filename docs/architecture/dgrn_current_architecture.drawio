        <mxCell id="62" value="Directional pooling&#xa;U_h = AvgPool(U, W) in B x C x H x 1&#xa;U_w = AvgPool(U, H) in B x C x 1 x W" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#4d4d4d;fontSize=12;" vertex="1" parent="1">
